<https://w3id.org/fom-table/public/ontology> rdf:type owl:Ontology ;
    owl:imports <../ontology/fom_individuals.ttl> ;
    rdfs:label "Channel and table ontology for FOM roll-to-roll coater" ;
    rdfs:comment "Semantic wrapper for the FOM coating and drying equipment" .


