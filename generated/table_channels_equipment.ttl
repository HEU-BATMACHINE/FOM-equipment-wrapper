fom-table:web.speed a emmo:EMMO_0f6f0120_c079_4d95_bb11_4ddee05e530e .
fom-table:web.speed dc:title "WebSpeed" .
fom-table:web.speed csvw:tableSchema fom-table:web.speed_schema .

fom-table:web.speed_schema a csvw:Schema .
fom-table:web.speed_schema csvw:columns fom-table:web.speed_schema_col1 .
fom-table:web.speed_schema csvw:columns fom-table:web.speed_schema_col2 .
fom-table:web.speed_schema csvw:primaryKey "time" .

fom-table:web.speed_process a chameo:CharacterisationMeasurementProcess ;
    chameo:hasMeasurementSample fom-ind:FOM_R2R ;
    emmo:EMMO_c4bace1d_4db0_4cd3_87e9_18122bae2840 fom-table:web.speed .

fom-table:web.speed_schema_col1 a csvw:Column .
fom-table:web.speed_schema_col1 csvw:propertyUrl equipment:hasDateTimeStampData .
fom-table:web.speed_schema_col1 csvw:datatype xsd:dateTime .
fom-table:web.speed_schema_col1 csvw:name "time" .
