@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix emmo: <https://w3id.org/emmo#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix battinfo: <http://w3id.org/battinfo#> .
@prefix chameo: <https://w3id.org/emmo/domain/characterisation-methodology/chameo#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann:    <http://purl.org/vocab/vann/> .
@prefix csvw: <http://www.w3.org/ns/csvw#> .

@prefix equipment: <https://w3id.org/batteryequipment/public/ontology#> .
@prefix coater: <https://w3id.org/coater/public/ontology#> .
@prefix fom: <https://w3id.org/fom/public/ontology#> .
@prefix fom-ind: <https://w3id.org/fom-ind/public/ontology#> .

<https://w3id.org/fom-ind/public/ontology> rdf:type owl:Ontology ;
        owl:imports <https://raw.githubusercontent.com/HEU-BATMACHINE/fom-public-resources/refs/heads/main/fom2.ttl> .

#-----------------------------------------
# FOM Coater equipment
#-----------------------------------------

#-----------------------------------------
# create the individual SINTEF FOM coater
fom-ind:FOM_R2R rdf:type coater:CoaterDryerEquipment .
fom-ind:FOM_R2R rdf:type owl:NamedIndividual .
fom-ind:FOM_R2R rdfs:label "FOM R2R" .
fom-ind:FOM_R2R equipment:hasDevice fom-ind:FOM_CoatingDevice .
fom-ind:FOM_R2R equipment:hasDevice fom-ind:FOM_UnwindingDevice .
fom-ind:FOM_R2R equipment:hasDevice fom-ind:FOM_RewindingDevice .
fom-ind:FOM_R2R equipment:hasDevice fom-ind:FOM_HotAir_DryerDevice .

# create the individual Devices
fom-ind:FOM_CoatingDevice rdf:type coater:CoatingDevice .
fom-ind:FOM_CoatingDevice rdf:type owl:NamedIndividual .
fom-ind:FOM_CoatingDevice rdfs:label "FOM CoatingDevice" .

fom-ind:FOM_UnwindingDevice rdf:type coater:UnwindingDevice .
fom-ind:FOM_UnwindingDevice rdf:type owl:NamedIndividual .
fom-ind:FOM_UnwindingDevice rdfs:label "FOM UnwindingDevice" .

fom-ind:FOM_RewindingDevice rdf:type coater:RewindingDevice .
fom-ind:FOM_RewindingDevice rdf:type owl:NamedIndividual .
fom-ind:FOM_RewindingDevice rdfs:label "FOM RewindingDevice" .


fom-ind:FOM_HotAir_DryerDevice rdf:type coater:HotAir_DryerDevice .
fom-ind:FOM_HotAir_DryerDevice rdf:type owl:NamedIndividual .
fom-ind:FOM_HotAir_DryerDevice rdfs:label "FOM DryerDevice" .

# section with concepts specific to FOM
fom-ind:FOM_Oven1 rdf:type fom:Oven1 .
fom-ind:FOM_Oven1 rdf:type owl:NamedIndividual .
fom-ind:FOM_Oven1 rdfs:label "FOM Oven1" .
fom-ind:FOM_HotAir_DryerDevice emmo:EMMO_17e27c22_37e1_468c_9dd7_95e137f73e7f fom-ind:FOM_Oven1 .

fom-ind:FOM_Oven2 rdf:type fom:Oven2 .
fom-ind:FOM_Oven2 rdf:type owl:NamedIndividual .
fom-ind:FOM_Oven2 rdfs:label "FOM Oven2" .
fom-ind:FOM_HotAir_DryerDevice emmo:EMMO_17e27c22_37e1_468c_9dd7_95e137f73e7f fom-ind:FOM_Oven2 .
fom-ind:FOM_Oven2 emmo:EMMO_60c57607_c9e7_4e75_a3d1_7a1f1f9928e4 fom-ind:FOM_Oven1 .

fom-ind:FOM_Oven3 rdf:type fom:Oven3 .
fom-ind:FOM_Oven3 rdf:type owl:NamedIndividual .
fom-ind:FOM_Oven3 rdfs:label "FOM Oven3" .
fom-ind:FOM_HotAir_DryerDevice emmo:EMMO_17e27c22_37e1_468c_9dd7_95e137f73e7f fom-ind:FOM_Oven3 .
fom-ind:FOM_Oven3 emmo:EMMO_60c57607_c9e7_4e75_a3d1_7a1f1f9928e4 fom-ind:FOM_Oven2 .

fom-ind:FOM_Inlet1 rdf:type fom:HotAir_Inlet .
fom-ind:FOM_Inlet1 rdf:type owl:NamedIndividual .
fom-ind:FOM_Inlet1 rdfs:label "FOM Fan Inlet1" .
fom-ind:FOM_Oven1 equipment:hasComponent fom-ind:FOM_Inlet1 .
fom-ind:FOM_Outlet1 rdf:type fom:HotAir_Outlet .
fom-ind:FOM_Outlet1 rdf:type owl:NamedIndividual .
fom-ind:FOM_Outlet1 rdfs:label "FOM Fan Outlet1" .
fom-ind:FOM_Oven1 equipment:hasComponent fom-ind:FOM_Outlet1 .
fom-ind:FOM_IRheater1 rdf:type fom:IRheater .
fom-ind:FOM_IRheater1 rdf:type owl:NamedIndividual .
fom-ind:FOM_IRheater1 rdfs:label "FOM IRheater1" .
fom-ind:FOM_Oven1 equipment:hasComponent fom-ind:FOM_IRheater1 .

fom-ind:FOM_Inlet2 rdf:type fom:HotAir_Inlet .
fom-ind:FOM_Inlet2 rdf:type owl:NamedIndividual .
fom-ind:FOM_Inlet2 rdfs:label "FOM Fan Inlet2" .
fom-ind:FOM_Oven2 equipment:hasComponent fom-ind:FOM_Inlet2 .
fom-ind:FOM_Outlet2 rdf:type fom:HotAir_Outlet .
fom-ind:FOM_Outlet2 rdf:type owl:NamedIndividual .
fom-ind:FOM_Outlet2 rdfs:label "FOM Fan Outlet2" .
fom-ind:FOM_Oven2 equipment:hasComponent fom-ind:FOM_Outlet2 .
fom-ind:FOM_IRheater2 rdf:type fom:IRheater .
fom-ind:FOM_IRheater2 rdf:type owl:NamedIndividual .
fom-ind:FOM_IRheater2 rdfs:label "FOM IRheater2" .
fom-ind:FOM_Oven2 equipment:hasComponent fom-ind:FOM_IRheater2 .

fom-ind:FOM_Inlet3 rdf:type fom:HotAir_Inlet .
fom-ind:FOM_Inlet3 rdf:type owl:NamedIndividual .
fom-ind:FOM_Inlet3 rdfs:label "FOM Fan Inlet3" .
fom-ind:FOM_Oven3 equipment:hasComponent fom-ind:FOM_Inlet3 .
fom-ind:FOM_Outlet3 rdf:type fom:HotAir_Outlet .
fom-ind:FOM_Outlet3 rdf:type owl:NamedIndividual .
fom-ind:FOM_Outlet3 rdfs:label "FOM Fan Outlet3" .
fom-ind:FOM_Oven3 equipment:hasComponent fom-ind:FOM_Outlet3 .
fom-ind:FOM_IRheater3 rdf:type fom:IRheater .
fom-ind:FOM_IRheater3 rdf:type owl:NamedIndividual .
fom-ind:FOM_IRheater3 rdfs:label "FOM IRheater3" .
fom-ind:FOM_Oven3 equipment:hasComponent fom-ind:FOM_IRheater3 .

#-----------------------------------------------------
# create the individual SINTEF FOM coater processes
fom-ind:FOM_CoaterDryerProcess rdf:type coater:ElectrodeCoatingDryingProcess ;
        rdf:type owl:NamedIndividual ;
        rdfs:label "FOM Coating Drying Process"@en ;
        # EMMO concept for hasTemporaryParticipant https://w3id.org/emmo#EMMO_35c29eb6_f57e_48d8_85af_854f9e926e77
        emmo:EMMO_35c29eb6_f57e_48d8_85af_854f9e926e77 fom-ind:FOM_R2R ;
        # EMMO concept for hasPart: https://w3id.org/emmo#EMMO_17e27c22_37e1_468c_9dd7_95e137f73e7f
        emmo:EMMO_17e27c22_37e1_468c_9dd7_95e137f73e7f fom-ind:FOM_UnwindingProcess ;
        emmo:EMMO_17e27c22_37e1_468c_9dd7_95e137f73e7f fom-ind:FOM_CoatingProcess ;
        emmo:EMMO_17e27c22_37e1_468c_9dd7_95e137f73e7f fom-ind:FOM_HA_DryingProcess ;
        emmo:EMMO_17e27c22_37e1_468c_9dd7_95e137f73e7f fom-ind:FOM_RewindingProcess .


fom-ind:FOM_CoatingProcess rdf:type coater:ElectrodeCoatingProcess ;
        rdf:type owl:NamedIndividual ;
        rdfs:label "FOM Coating Process"@en ;
        # EMMO concept for hasTemporaryParticipant https://w3id.org/emmo#EMMO_35c29eb6_f57e_48d8_85af_854f9e926e77
        emmo:EMMO_35c29eb6_f57e_48d8_85af_854f9e926e77 fom-ind:FOM_CoatingDevice .

fom-ind:FOM_UnwindingProcess rdf:type coater:ElectrodeUnwindingProcess ;
        rdf:type owl:NamedIndividual ;
        rdfs:label "FOM Unwinding Process"@en ;
        # EMMO concept for hasTemporaryParticipant https://w3id.org/emmo#EMMO_35c29eb6_f57e_48d8_85af_854f9e926e77
        emmo:EMMO_35c29eb6_f57e_48d8_85af_854f9e926e77 fom-ind:FOM_UnwindingDevice .

fom-ind:FOM_RewindingProcess rdf:type coater:ElectrodeRewindingProcess ;
        rdf:type owl:NamedIndividual ;
        rdfs:label "FOM Rewinding Process"@en ;
        # EMMO concept for hasTemporaryParticipant https://w3id.org/emmo#EMMO_35c29eb6_f57e_48d8_85af_854f9e926e77
        emmo:EMMO_35c29eb6_f57e_48d8_85af_854f9e926e77 fom-ind:FOM_RewindingDevice .

fom-ind:FOM_HA_DryingProcess rdf:type coater:ElectrodeDryingProcess ;
        rdf:type owl:NamedIndividual ;
        rdfs:label "FOM Hot Air Drying Process"@en ;
        # EMMO concept for hasTemporaryParticipant https://w3id.org/emmo#EMMO_35c29eb6_f57e_48d8_85af_854f9e926e77
        emmo:EMMO_35c29eb6_f57e_48d8_85af_854f9e926e77 fom-ind:FOM_HotAir_DryerDevice .

# workflow hasNext emmo:EMMO_499e24a5_5072_4c83_8625_fe3f96ae4a8d
fom-ind:FOM_UnwindingProcess emmo:EMMO_499e24a5_5072_4c83_8625_fe3f96ae4a8d fom-ind:FOM_CoatingProcess .
fom-ind:FOM_CoatingProcess emmo:EMMO_499e24a5_5072_4c83_8625_fe3f96ae4a8d fom-ind:FOM_HA_DryingProcess .
fom-ind:FOM_HA_DryingProcess emmo:EMMO_499e24a5_5072_4c83_8625_fe3f96ae4a8d fom-ind:FOM_RewindingProcess .

### Example Individuals ###

fom-ind:FOM_R2R equipment:hasEquipmentModel "custom designed FOM moduloR2R" ;
    coater:hasCoatingSpeedMin "0.01"^^xsd:float ;
    coater:hasCoatingSpeedMax "15.0"^^xsd:float ;
    coater:hasRollerWidth "350.0"^^xsd:float ;
    coater:hasSubstrateWidth "350.0"^^xsd:float .

fom-ind:FOM_CoatingDevice rdf:type coater:CoatingDevice ;
    coater:hasCoatingWidth "300.0"^^xsd:float .

fom-ind:FOM_HotAir_DryerDevice rdf:type coater:HotAir_DryerDevice ;
    coater:hasTemperatureMax "200.0"^^xsd:float .
